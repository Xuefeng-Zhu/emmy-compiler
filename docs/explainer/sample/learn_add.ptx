.version 8.0
.target sm_89
.address_size 64

.visible .entry learn_add(
    .param .u64 param_left,
    .param .u64 param_right,
    .param .u64 param_result
)
{
    .reg .pred %p<1>;
    .reg .b32 %r<4>;
    .reg .b64 %rd<12>;
    .reg .f32 %f<3>;
    ld.param.u64 %rd0, [param_left];
    cvta.to.global.u64 %rd1, %rd0;
    ld.param.u64 %rd2, [param_right];
    cvta.to.global.u64 %rd3, %rd2;
    ld.param.u64 %rd4, [param_result];
    cvta.to.global.u64 %rd5, %rd4;
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mad.lo.u32 %r3, %r1, %r2, %r0;
    setp.ge.u32 %p0, %r3, 10;
    @%p0 bra DONE;
    mul.wide.u32 %rd6, %r3, 4;
    add.u64 %rd7, %rd1, %rd6;
    ld.global.f32 %f0, [%rd7+0];
    mul.wide.u32 %rd8, %r3, 4;
    add.u64 %rd9, %rd3, %rd8;
    ld.global.f32 %f1, [%rd9+0];
    add.rn.f32 %f2, %f0, %f1;
    mul.wide.u32 %rd10, %r3, 4;
    add.u64 %rd11, %rd5, %rd10;
    st.global.f32 [%rd11+0], %f2;
DONE:
    ret;
}
