.version 8.0
.target sm_89
.address_size 64

.visible .entry k_sum_1_reduce(
    .param .u64 param_x,
    .param .u64 param_sum_1
)
.reqntid 128, 1, 1
{
    .reg .pred %p<1>;
    .reg .b32 %r<15>;
    .reg .b64 %rd<8>;
    .reg .f32 %f<3>;
    .shared .align 4 .b8 sum_smem[16];
    ld.param.u64 %rd0, [param_x];
    cvta.to.global.u64 %rd1, %rd0;
    ld.param.u64 %rd2, [param_sum_1];
    cvta.to.global.u64 %rd3, %rd2;
    mov.u32 %r0, %tid.x;
    and.b32 %r1, %r0, 31;
    shr.u32 %r2, %r0, 5;
    mov.f32 %f0, 0f00000000;
    mov.u32 %r3, %r0;
    mov.u32 %r4, %ctaid.x;
SUM_LOOP:
    setp.ge.u32 %p0, %r3, 512;
    @%p0 bra SUM_LOOP_DONE;
    mul.lo.s32 %r5, 0, 64;
    add.s32 %r6, %r5, %r4;
    mul.lo.s32 %r7, %r6, 512;
    add.s32 %r8, %r7, %r3;
    mul.wide.u32 %rd4, %r8, 4;
    add.u64 %rd5, %rd1, %rd4;
    ld.global.f32 %f2, [%rd5+0];
    add.rn.f32 %f0, %f0, %f2;
    add.u32 %r3, %r3, 128;
    bra SUM_LOOP;
SUM_LOOP_DONE:
    mov.b32 %r9, %f0;
    shfl.sync.bfly.b32 %r10, %r9, 16, 31, 0xffffffff;
    mov.b32 %f1, %r10;
    add.rn.f32 %f0, %f0, %f1;
    mov.b32 %r9, %f0;
    shfl.sync.bfly.b32 %r10, %r9, 8, 31, 0xffffffff;
    mov.b32 %f1, %r10;
    add.rn.f32 %f0, %f0, %f1;
    mov.b32 %r9, %f0;
    shfl.sync.bfly.b32 %r10, %r9, 4, 31, 0xffffffff;
    mov.b32 %f1, %r10;
    add.rn.f32 %f0, %f0, %f1;
    mov.b32 %r9, %f0;
    shfl.sync.bfly.b32 %r10, %r9, 2, 31, 0xffffffff;
    mov.b32 %f1, %r10;
    add.rn.f32 %f0, %f0, %f1;
    mov.b32 %r9, %f0;
    shfl.sync.bfly.b32 %r10, %r9, 1, 31, 0xffffffff;
    mov.b32 %f1, %r10;
    add.rn.f32 %f0, %f0, %f1;
    mov.u32 %r11, sum_smem;
    mul.lo.u32 %r12, %r2, 4;
    add.u32 %r13, %r11, %r12;
    setp.ne.u32 %p0, %r1, 0;
    @%p0 bra PARTIALS_DONE;
    st.shared.f32 [%r13], %f0;
PARTIALS_DONE:
    bar.sync 0;
    setp.ne.u32 %p0, %r1, 0;
    @%p0 bra TREE_DONE_2;
    setp.ge.u32 %p0, %r2, 2;
    @%p0 bra TREE_DONE_2;
    ld.shared.f32 %f0, [%r13];
    add.u32 %r14, %r13, 8;
    ld.shared.f32 %f1, [%r14];
    add.rn.f32 %f0, %f0, %f1;
    st.shared.f32 [%r13], %f0;
TREE_DONE_2:
    bar.sync 0;
    setp.ne.u32 %p0, %r1, 0;
    @%p0 bra TREE_DONE_1;
    setp.ge.u32 %p0, %r2, 1;
    @%p0 bra TREE_DONE_1;
    ld.shared.f32 %f0, [%r13];
    add.u32 %r14, %r13, 4;
    ld.shared.f32 %f1, [%r14];
    add.rn.f32 %f0, %f0, %f1;
    st.shared.f32 [%r13], %f0;
TREE_DONE_1:
    bar.sync 0;
    ld.shared.f32 %f0, [%r11];
    setp.ne.u32 %p0, %r0, 0;
    @%p0 bra DONE;
    mul.wide.u32 %rd6, %r4, 4;
    add.u64 %rd7, %rd3, %rd6;
    st.global.f32 [%rd7], %f0;
DONE:
    ret;
}
