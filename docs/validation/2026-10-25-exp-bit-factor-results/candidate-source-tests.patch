diff --git a/tests/test_exp_bit_factors.py b/tests/test_exp_bit_factors.py
new file mode 100644
index 0000000..6ee11b2
--- /dev/null
+++ b/tests/test_exp_bit_factors.py
@@ -0,0 +1,102 @@
+"""Independent PTX operand probes for exact exp scale construction.
+
+These CPU models check bits and operand flow, not NVIDIA approximation error,
+assembly or timing. The numeric exp tests retain their existing tolerances.
+"""
+import math
+import unittest
+
+import numpy as np
+
+from emmy_ptx.ptx import Emitter
+from matmul_model import run_matmul_ptx
+from reduction_model import run_reduction_ptx
+from structured_model import run_structured_ptx
+from test_float_rounding_model import launch, probe
+
+
+MODELS = (run_structured_ptx, run_reduction_ptx, run_matmul_ptx)
+
+
+def bit_probe(instructions):
+    return (probe(instructions).replace('.reg .b32 %r<1>;', '.reg .b32 %r<5>;')
+            .replace('.reg .f32 %f<4>;', '.reg .f32 %f<6>;\n    .shared .align 4 .b8 scratch[4];'))
+
+
+class ExactExpScaleModelTests(unittest.TestCase):
+    def check_bits(self, instructions, values, expected_bits):
+        expected_bits = np.asarray(expected_bits, np.uint32)
+        for model in MODELS:
+            with self.subTest(model=model.__name__):
+                actual = model(bit_probe(instructions), launch(values)).outputs['result']
+                np.testing.assert_array_equal(actual[:len(expected_bits)].view(np.uint32), expected_bits)
+
+    def test_signed_conversion_truncates_both_signs_and_handles_special_values(self):
+        smallest = np.array([1], np.uint32).view(np.float32)[0]
+        values = [-75.9, -1.9, -0.9, -0.0, 0.0, 0.9, 1.9, 64.9,
+                  -smallest, smallest, np.nan, -np.nan, -np.inf, np.inf,
+                  -(2**31), 2**31, np.finfo(np.float32).max, -np.finfo(np.float32).max]
+        integers = [-75, -1, 0, 0, 0, 0, 1, 64, 0, 0, 0, 0,
+                    -(2**31), 2**31 - 1, -(2**31), 2**31 - 1,
+                    2**31 - 1, -(2**31)]
+        self.check_bits('cvt.rzi.s32.f32 %r1, %f0;\n    mov.b32 %f1, %r1;',
+                        values, [v & 0xffffffff for v in integers])
+
+    def test_bit_moves_preserve_float_bits_in_both_directions(self):
+        bits = np.array([0x00000000, 0x80000000, 0x00000001, 0x007fffff,
+                         0x00800000, 0x3f800000, 0xc2960000, 0x7f800000,
+                         0xff800000, 0x7fc12345], np.uint32)
+        self.check_bits('mov.b32 %r1, %f0;\n    mov.b32 %f2, %r1;\n    mov.b32 %f1, %f2;',
+                        bits.view(np.float32), bits)
+
+    def test_shift_drops_overflow_and_clamps_32_bit_shift_amount(self):
+        for amount, expected in [(0, 0xffffffff), (23, 0xff800000), (31, 0x80000000),
+                                 (32, 0), (33, 0), (0xffffffff, 0)]:
+            with self.subTest(amount=amount):
+                self.check_bits(f'mov.u32 %r1, 4294967295;\n    shl.b32 %r2, %r1, {amount};\n    mov.b32 %f1, %r2;',
+                                [0], [expected])
+
+    def test_every_scale_exponent_produces_exact_normal_power_of_two(self):
+        # Independent IEEE values computed via exact binary scaling, covering
+        # every integer exponent admitted by either half of the clamped exp.
+        for start in range(-75, 65, 32):
+            values = list(range(start, min(start + 32, 65)))
+            expected = np.array([math.ldexp(1.0, k) for k in values], np.float32)
+            self.check_bits('cvt.rzi.s32.f32 %r1, %f0;\n    add.s32 %r2, %r1, 127;\n'
+                            '    shl.b32 %r3, %r2, 23;\n    mov.b32 %f1, %r3;',
+                            values, expected.view(np.uint32))
+            self.assertTrue(np.all((expected >= np.finfo(np.float32).tiny) & np.isfinite(expected)))
+
+    def test_final_multiply_keeps_subnormal_rounding_and_overflow(self):
+        # Each operand is normal. Only the final product crosses a boundary.
+        # 2^-150 ties to zero; the next f32 partial above one rounds to 2^-149.
+        lower = ('mul.rn.f32 %f2, %f0, 0f1a000000;\n'
+                 '    mul.rn.f32 %f1, %f2, 0f1a000000;')  # both 2^-75
+        self.check_bits(lower, [1.0, np.nextafter(np.float32(1), np.float32(2)), 2.0],
+                        [0, 1, 1])
+        upper = ('mul.rn.f32 %f2, %f0, 0f5f800000;\n'
+                 '    mul.rn.f32 %f1, %f2, 0f5f800000;')  # both 2^64
+        self.check_bits(upper, [0.5, 1.0], [0x7f000000, 0x7f800000])
+
+    def test_emitter_retains_clamps_reduction_and_separate_product_order(self):
+        emitter = Emitter(None)
+        emitter.emit_math('exp', ['%input'])
+        lines = [line.strip() for line in emitter.lines]
+        self.assertEqual(len(lines), 23)
+        self.assertEqual(sum(line.startswith('ex2.approx.f32 ') for line in lines), 1)
+        self.assertEqual(sum(line.startswith('cvt.rzi.s32.f32 ') for line in lines), 2)
+        self.assertEqual(sum(line.startswith('mov.b32 ') for line in lines), 2)
+        self.assertTrue(lines[0].startswith('max.NaN.f32 '))
+        self.assertTrue(lines[1].startswith('min.NaN.f32 '))
+        self.assertTrue(any('0f3f317200' in line for line in lines))
+        self.assertTrue(any('0f35bfbe8e' in line for line in lines))
+        self.assertFalse(any('.ftz' in line or 'fma.' in line for line in lines))
+        scales = [line.split()[1].rstrip(',') for line in lines if line.startswith('mov.b32 ')]
+        self.assertTrue(lines[-2].endswith(', ' + scales[0] + ';'))
+        self.assertTrue(lines[-1].endswith(', ' + scales[1] + ';'))
+        intermediate = lines[-2].split()[1].rstrip(',')
+        self.assertIn(', ' + intermediate + ', ', lines[-1])
+
+
+if __name__ == '__main__':
+    unittest.main()
